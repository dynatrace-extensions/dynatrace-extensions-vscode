  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-functional": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-no-secrets": "^2",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-prettier": "^5.5",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-redos": "^4.5.0",
    "eslint-plugin-sonarjs": "^4",
    "eslint-plugin-testing-library": "^7",
    "globals": "^15",
    "prettier": "^3.3.2",
    "typescript": "^5.8",
    "typescript-eslint": "^8",
    "vite": "^7.3.5"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "arrowParens": "avoid",
    "tabWidth": 2,
    "bracketSameLine": false,
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "htmlWhitespaceSensitivity": "strict",
    "insertPragma": false,
    "jsxSingleQuote": true,
    "printWidth": 100,
    "proseWrap": "preserve",
    "quoteProps": "consistent",
    "requirePragma": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "editorconfig": true
  },
  "dependencies": {
    "@dynatrace-sdk/units": "^1.5.0",
    "@dynatrace/strato-components": "^3.5.0",
    "@dynatrace/strato-components-preview": "^3.1.5",
