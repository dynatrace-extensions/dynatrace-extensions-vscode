    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-intl": "^6.6.8",
    "sql-formatter": "^15.3.2",
    "styled-components": "^6.1.18",
    "wicg-inert": "^3.1.2"
